{
  "name": "grad-studio",
  "productName": "GradStudio",
  "version": "3.0.8",
  "releaseDate": "2026-10-08",
  "description": "grad studio - Vue3 + Electron + MySQL",
  "main": "electron/main.js",
  "author": "yconghua",
  "license": "MIT",
  "publishConfig": {
    "@yconghua:registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5173 && electron .\"",
    "vite": "vite",
    "build": "vite build",
    "start": "electron .",
    "pack": "npm run build && electron-builder"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "docx": "^9.8.1",
    "dompurify": "^3.4.16",
    "electron-updater": "^6.3.9",
    "exceljs": "^4.4.0",
    "marked": "^18.0.14",
    "mysql2": "^3.11.0",
    "papaparse": "^5.7.0",
    "qrcode": "^1.5.4",
    "remark-parse": "^10.0.2",
    "unified": "^10.1.2",
    "vue": "^3.4.27",
    "vue-router": "^4.3.2",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.2.11",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.grad.studio",
    "productName": "GradStudio",
    "artifactName": "${productName}.Setup.${version}.${ext}",
    "icon": "build/icon.ico",
    "publish": {
      "provider": "generic",
      "url": "https://gh-proxy.com/https://github.com/yconghua/grad-studio/releases/latest/download"
    },
    "files": [
      "electron/**/*",
      "shared/**/*",
      "dist/**/*",
      "build/**/*"
    ],
    "extraResources": [
      {
        "from": "scan-server",
        "to": "scan-server"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
